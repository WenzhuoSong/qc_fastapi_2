# .env.example — copy to .env and fill in real values

DATABASE_URL=postgresql://user:password@localhost:5432/noble_flow

# ── Shared ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini            # news summarisation
FINNHUB_API_KEY=                    # news + earnings calendar (free tier is enough)
ALPHAVANTAGE_API_KEY=               # optional news source

# ── Scout ────────────────────────────────────────────────
SCOUT_LLM_MODEL=gpt-4o-mini
SCOUT_TG_BOT_TOKEN=                 # dedicated bot recommended; falls back to TG_BOT_TOKEN
SCOUT_TG_CHAT_ID=                   # only this chat may talk to the bot; falls back to TG_CHAT_ID
SCOUT_TG_WEBHOOK_SECRET=            # random string, also passed to setWebhook as secret_token
SCOUT_DASHBOARD_USER=
SCOUT_DASHBOARD_PASSWORD=
# SCOUT_TOP_N=8
# SCOUT_PUSH_THRESHOLD=0.6
# SCOUT_MAX_PUSH_CARDS=3

# ── QC observer ──────────────────────────────────────────
WEBHOOK_SECRET=your-strong-secret-here
TG_BOT_TOKEN=your-ops-bot-token
TG_CHAT_ID=your-chat-id
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# Observer-first safety fence. No value enables FastAPI-originated QC commands.
FASTAPI_EXECUTION_AUTHORITY=none
QC_OBSERVER_REQUIRE_REQUEST_V2=false
QC_OBSERVER_ALLOWED_ACCOUNTS=
QC_OBSERVER_ALLOWED_DEPLOYMENTS=
QC_OBSERVER_MAX_CLOCK_SKEW_SECONDS=600
