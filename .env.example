# .env.example — 复制为 .env 并填入真实値

DATABASE_URL=postgresql://qc_fastapi_2:password@localhost:5432/qc_fastapi_2

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_HEAVY=gpt-5.4-mini

WEBHOOK_USER=qc
WEBHOOK_SECRET=your-strong-secret-here

QC_API_URL=https://www.quantconnect.com/api/v2
QC_USER_ID=your-qc-user-id
QC_API_TOKEN=your-qc-api-token
QC_PROJECT_ID=your-project-id

TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

AUTHORIZATION_MODE=SEMI_AUTO

# Observer-first safety fence. No value enables FastAPI-originated QC commands
# in this release; keep this explicit in every deployed environment.
FASTAPI_EXECUTION_AUTHORITY=none
QC_OBSERVER_REQUIRE_REQUEST_V2=false
QC_OBSERVER_ALLOWED_ACCOUNTS=
QC_OBSERVER_ALLOWED_DEPLOYMENTS=
QC_OBSERVER_MAX_CLOCK_SKEW_SECONDS=600
