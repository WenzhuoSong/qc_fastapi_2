# .env.example — copy to .env and fill in real values
# On Railway shared secrets live in the environment's Shared Variables, referenced as ${{shared.X}}.

DATABASE_URL=postgresql://user:password@localhost:5432/noble_flow

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini            # news summarisation
FINNHUB_API_KEY=                    # news + earnings calendar (free tier is enough)
ALPHAVANTAGE_API_KEY=               # optional news source

TG_BOT_TOKEN=                       # bot used for Scout pushes and job alerts
TG_CHAT_ID=                         # only this chat may talk to the bot
DASHBOARD_USER=                     # Scout dashboard login (scout-web references these)
DASHBOARD_PASSWORD=

# Scout-only (scout-web)
SCOUT_TG_WEBHOOK_SECRET=            # random string, also passed to setWebhook as secret_token
# SCOUT_DASHBOARD_USER / SCOUT_DASHBOARD_PASSWORD   (default: reference DASHBOARD_*)
# SCOUT_TG_BOT_TOKEN / SCOUT_TG_CHAT_ID             (optional dedicated bot; falls back to TG_*)
# SCOUT_LLM_MODEL=gpt-4o-mini
# SCOUT_TOP_N=8
# SCOUT_PUSH_THRESHOLD=0.6
# SCOUT_MAX_PUSH_CARDS=3
